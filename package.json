{
  "name": "mindweft",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm --filter @mindweft/web dev",
    "build": "turbo run build",
    "test": "prettier --check . && turbo run lint typecheck test e2e",
    "lint:fix": "turbo run lint -- --fix",
    "format:fix": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "turbo": "^2.10.4"
  }
}
